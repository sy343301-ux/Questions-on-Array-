#include <stdio.h>

int main() {
    int n, i, smallest, secondSmallest;
    int hasSecond = 0;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n < 2) {
        printf("Need at least 2 elements.\n");
        return 1;
    }

    int a[n];

    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    smallest = a[0];
    secondSmallest = a[1];

    for (i = 1; i < n; i++) {
        if (a[i] < smallest) {
            secondSmallest = smallest;
            smallest = a[i];
            hasSecond = 1;
        } else if (a[i] > smallest && (!hasSecond || a[i] < secondSmallest)) {
            secondSmallest = a[i];
            hasSecond = 1;
        }
    }

    if (hasSecond)
        printf("Second smallest distinct element = %d\n", secondSmallest);
    else
        printf("There is no second distinct smallest element.\n");

    return 0;
}